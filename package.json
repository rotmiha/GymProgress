{
  "name": "gymprogress",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vitest": "^4.1.12",
    "typescript": "^5.9.3"
  }
}
